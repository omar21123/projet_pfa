{
    "openapi": "3.0.0",
    "info": {
        "title": "Souk API",
        "description": "API du marketplace",
        "version": "1.0.0"
    },
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Créer un compte utilisateur",
                "operationId": "d764dd091cc4494ae0baf360b03319f3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "email",
                                    "password",
                                    "account_type"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Ali"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Benali"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ali@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Password123!"
                                    },
                                    "phone_number": {
                                        "type": "string",
                                        "example": "+212600000000",
                                        "nullable": true
                                    },
                                    "birth_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1998-04-12",
                                        "nullable": true
                                    },
                                    "gender": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "account_type": {
                                        "type": "string",
                                        "example": "customer"
                                    },
                                    "store_name": {
                                        "type": "string",
                                        "example": "My Store",
                                        "nullable": true
                                    },
                                    "store_description": {
                                        "type": "string",
                                        "example": "Boutique en ligne",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compte créé avec succès"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion utilisateur",
                "operationId": "8dcb70df1020986038d098cc08d05dae",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ali@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Password123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "summary": "Health check",
                "operationId": "391185c83cc9144694356347ab960c3d",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/test": {
            "get": {
                "tags": [
                    "Test"
                ],
                "summary": "Route de test pour vérifier Swagger",
                "operationId": "4bd555185e754072eb17825b92b4ac9a",
                "responses": {
                    "200": {
                        "description": "Ça fonctionne"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Authentification et création de compte"
        },
        {
            "name": "Test",
            "description": "Test"
        }
    ]
}
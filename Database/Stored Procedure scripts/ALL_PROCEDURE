            ErrorNumber,
            ErrorMessage,
            ContextData
        )
        VALUES
        (
            'SP_GetPromotionsByProduct',
            @p_sqlstate,
            @p_errno,
            @p_message,
            JSON_OBJECT(
                'UserPublicID', v_UserPublicID,
                'ProductID', v_ProductID
            )
        );

        SET v_Success = FALSE;
        SET v_Message = 'Une erreur est survenue lors de la récupération des promotions.';

        SET IsDefaultForAttribute = 1
        WHERE OptionID = p_OptionID;
    END IF;

    INSERT INTO ProductDetails (ProductID, ProductsConfigAttributeID, OptionID)
    VALUES (p_ProductID, p_ConfigID, p_OptionID);

    SET p_DetailID = LAST_INSERT_ID();

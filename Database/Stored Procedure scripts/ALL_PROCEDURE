CREATE DEFINER=`root`@`%` PROCEDURE `SP_RejectVendor`(
    IN p_VendorProfileID INT,
    IN p_VerifiedBy INT,
    IN p_RejectionNotes VARCHAR(500)
)
BEGIN
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    UPDATE VendorProfiles
    SET
        VerificationStatus = 2,          -- Rejected
        IsApproved         = 0,
        VerifiedBy         = p_VerifiedBy,
        RejectionNotes     = p_RejectionNotes,
        UpdatedAt          = UTC_TIMESTAMP()
    WHERE VendorProfileID = p_VendorProfileID;

    COMMIT;

    SELECT
        VendorProfileID,
        VerificationStatus,
        IsApproved,
        VerifiedBy,
        RejectionNotes
    FROM VendorProfiles
    WHERE VendorProfileID = p_VendorProfileID;
END ;;

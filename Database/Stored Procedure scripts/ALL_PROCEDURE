CREATE DEFINER=`root`@`%` FUNCTION `fn_GetVendorProfileProgress`(
    p_UserID INT
) RETURNS decimal(5,2)
    READS SQL DATA
    DETERMINISTIC
BEGIN
    DECLARE v_Progress DECIMAL(5,2) DEFAULT 0.00;

    DECLARE v_StoreName        VARCHAR(150) DEFAULT NULL;
    DECLARE v_BannerURL        VARCHAR(500) DEFAULT NULL;
    DECLARE v_LogoURL          VARCHAR(500) DEFAULT NULL;
    DECLARE v_Description      TEXT         DEFAULT NULL;
    DECLARE v_IdentityVerified TINYINT(1)   DEFAULT 0;
    DECLARE v_BusinessVerified TINYINT(1)   DEFAULT 0;
    DECLARE v_BankVerified     TINYINT(1)   DEFAULT 0;
    DECLARE v_HasAddress       INT          DEFAULT 0;

    -- Load vendor profile fields
    SELECT
        StoreName,
        BannerURL,
        LogoURL,
        Description,
        IdentityVerified,
        BusinessVerified,
        BankVerified
    INTO
        v_StoreName,
        v_BannerURL,
        v_LogoURL,
        v_Description,
        v_IdentityVerified,
        v_BusinessVerified,
        v_BankVerified
    FROM VendorProfiles
    WHERE UserID = p_UserID
    LIMIT 1;

    -- Load address existence
    SELECT COUNT(*)
    INTO v_HasAddress
    FROM Addresses
    WHERE UserID = p_UserID;

    -- Identity Verified     → 25%
    IF v_IdentityVerified = 1                            THEN SET v_Progress = v_Progress + 25.00; END IF;
    -- Business Verified     → 20%
    IF v_BusinessVerified = 1                            THEN SET v_Progress = v_Progress + 20.00; END IF;
    -- Bank Verified         → 15%
    IF v_BankVerified     = 1                            THEN SET v_Progress = v_Progress + 15.00; END IF;
    -- Has Address           → 15%
    IF v_HasAddress       > 0                            THEN SET v_Progress = v_Progress + 15.00; END IF;
    -- Has Description       → 10%
    IF v_Description IS NOT NULL AND v_Description != '' THEN SET v_Progress = v_Progress + 10.00; END IF;
    -- Has Logo              → 7%
    IF v_LogoURL     IS NOT NULL AND v_LogoURL     != '' THEN SET v_Progress = v_Progress +  7.00; END IF;
    -- Has Store Name        → 5%
    IF v_StoreName   IS NOT NULL AND v_StoreName   != '' THEN SET v_Progress = v_Progress +  5.00; END IF;
    -- Has Banner            → 3%
    IF v_BannerURL   IS NOT NULL AND v_BannerURL   != '' THEN SET v_Progress = v_Progress +  3.00; END IF;

    RETURN ROUND(v_Progress, 2);

END ;;

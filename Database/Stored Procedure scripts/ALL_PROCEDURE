CREATE DEFINER=`root`@`%` PROCEDURE `SP_LogGuestSearch`(
    IN  v_SearchTermID INT,
    IN  v_IPAddress    VARCHAR(45),
    OUT v_Success      BOOLEAN,
    OUT v_Message      VARCHAR(255)
)
BEGIN
    DECLARE v_AlreadyExists INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        GET DIAGNOSTICS CONDITION 1
            @p_sqlstate = RETURNED_SQLSTATE,
            @p_errno    = MYSQL_ERRNO,
            @p_message  = MESSAGE_TEXT;
        INSERT INTO SPErrorLogs (ProcedureName, ErrorSQLState, ErrorNumber, ErrorMessage, ContextData)
        VALUES (
            'SP_LogGuestSearch',
            @p_sqlstate,
            @p_errno,
            @p_message,
            JSON_OBJECT('SearchTermID', v_SearchTermID, 'IPAddress', v_IPAddress)
        );
        SET v_Success = FALSE;
        SET v_Message = 'Une erreur est survenue lors de l''enregistrement de la recherche invité.';
    END;

    SET v_Success = FALSE;
    SET v_Message = '';

    IF v_SearchTermID IS NULL THEN
        SET v_Message = 'SearchTermID est requis.';
    ELSEIF v_IPAddress IS NULL THEN
        SET v_Message = 'IPAddress est requis.';
    ELSE
        SELECT COUNT(*) INTO v_AlreadyExists
        FROM UserSearchHistory
        WHERE UserID       IS NULL
          AND IPAddress     = v_IPAddress
          AND SearchTermID  = v_SearchTermID;

        IF v_AlreadyExists > 0 THEN
            SET v_Success = TRUE;
            SET v_Message = 'Recherche déjà enregistrée pour cette adresse IP.';
        ELSE
            INSERT INTO UserSearchHistory (UserID, SearchTermID, IPAddress, SearchedAt)
            VALUES (NULL, v_SearchTermID, v_IPAddress, NOW());

            SET v_Success = TRUE;
            SET v_Message = 'OK';
        END IF;
    END IF;

END ;;
DELIMITER ;

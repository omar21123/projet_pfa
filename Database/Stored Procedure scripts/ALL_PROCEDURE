    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        GET DIAGNOSTICS CONDITION 1
            @p_sqlstate = RETURNED_SQLSTATE,
            @p_errno    = MYSQL_ERRNO,
            @p_message  = MESSAGE_TEXT;

        INSERT INTO SPErrorLogs
        (
            ProcedureName,
            ErrorSQLState,
            ErrorNumber,
            ErrorMessage,
            ContextData
        )
        VALUES
        (
            'SP_GetPromotionsByCategory',
            @p_sqlstate,
            @p_errno,
            @p_message,

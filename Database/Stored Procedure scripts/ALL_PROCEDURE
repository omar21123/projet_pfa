    DECLARE v_VendorProfileID INT;
    DECLARE v_OwnerVendorID INT;
    DECLARE v_DiscountTypeID INT UNSIGNED;
    DECLARE v_ScopeTypeID INT UNSIGNED;
    DECLARE v_StatusID INT UNSIGNED;
    DECLARE v_DuplicateCode INT;

